# ── Django ──────────────────────────────────────────────
DJANGO_SECRET_KEY=cambia-esta-clave-secreta-en-produccion
DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── PostgreSQL (base de datos) ───────────────────────────
DB_NAME=happypaws
DB_USER=postgres
DB_PASSWORD=tu-password-aqui
DB_PORT=5432

# Desarrollo local con Cloud SQL Proxy en localhost
DB_HOST=127.0.0.1

# Producción en Cloud Run — dejar vacío en local
# Formato: proyecto:region:instancia  (ej: happypawschl:us-central1:happypaws-db)
CLOUD_SQL_CONNECTION_NAME=
